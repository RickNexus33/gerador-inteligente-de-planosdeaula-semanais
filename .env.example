# GEMINI_API_KEY: Obrigatória para as chamadas à API do Gemini.
#
# Obtenha uma chave gratuita em: https://aistudio.google.com/app/apikey
#
# LOCAL: crie um arquivo .env na raiz com GEMINI_API_KEY="sua_chave".
# VERCEL: configure em Settings > Environment Variables > GEMINI_API_KEY
#         (marque os ambientes Production, Preview e Development) e faça um
#         novo deploy para que a variável passe a valer.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde a aplicação está hospedada (opcional).
APP_URL="MY_APP_URL"
